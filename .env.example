# The Odds API — https://the-odds-api.com/ (500 req/Monat pro Key)
# Mehrere Keys kommagetrennt für Rotation
THE_ODDS_API_KEYS=key1,key2,key3

# Flask
SECRET_KEY=change-me-to-something-random

# Telegram Bot
# 1. @BotFather in Telegram anschreiben → /newbot → Token kopieren
# 2. Bot anschreiben, dann: https://api.telegram.org/bot<TOKEN>/getUpdates → chat id kopieren
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner auto-start (true = startet beim App-Launch, ideal für Cloud)
AUTO_START_SCANNER=true

# Google OAuth2 (optional — für Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
